# Shopify CLI bu değerleri `npm run dev` sırasında kendisi doldurur.
# Üretim sunucunuzda (Fly.io, Render, Heroku …) elle tanımlamanız gerekir.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://uygulamanizin-adresi.com
SCOPES=write_discounts,write_customers

# GELİŞTİRME: SQLite yeterlidir. `npm run dev` öncesinde otomatik çalışan
# `predev` → `npm run dev:db` adımı prisma/schema.dev.prisma (sqlite) ile
# client üretir ve `prisma db push` ile tabloları oluşturur.
# Ana şema (prisma/schema.prisma) PostgreSQL'dir ve yalnızca üretimde
# kullanılır; geliştirme için onu DEĞİŞTİRMEYİN.
DATABASE_URL=file:dev.sqlite

# ÜRETİM (Railway vb.): PostgreSQL bağlantı adresini kullanın, örn.
# DATABASE_URL=postgresql://kullanici:sifre@host:5432/veritabani

# Yalnızca özel (custom) mağaza alan adı kullanıyorsanız gerekir.
# SHOP_CUSTOM_DOMAIN=
