# Shopify CLI bu değerleri `npm run dev` sırasında kendisi doldurur.
# Üretim sunucunuzda (Fly.io, Render, Heroku …) elle tanımlamanız gerekir.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://uygulamanizin-adresi.com
SCOPES=write_discounts,write_customers

# Geliştirme için SQLite yeterlidir.
# Üretimde kalıcı bir veritabanı kullanın (PostgreSQL önerilir) ve
# prisma/schema.prisma içindeki provider satırını da güncelleyin.
DATABASE_URL=file:dev.sqlite

# Yalnızca özel (custom) mağaza alan adı kullanıyorsanız gerekir.
# SHOP_CUSTOM_DOMAIN=
